{
  "name": "ascii-directory",
  "version": "1.0.0",
  "description": "1980s CRT Terminal ASCII Directory & Gateway Web App for Proxmox and Cloudflare",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --out-dir dist/server --clean",
    "build": "vite build && tsup src/server/index.ts --format esm --out-dir dist/server --clean",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "keywords": [
    "ascii",
    "terminal",
    "retro",
    "crt",
    "directory",
    "homelab",
    "proxmox",
    "cloudflare"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
