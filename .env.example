# ASCII Directory Configuration

# HTTP Port and Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Server-Side Admin Authentication
# Used to authenticate with `login <password>` in the terminal prompt
ADMIN_PASSWORD=your_secure_password_here

# JWT Secret for Session Cookies
JWT_SECRET=generate_a_random_32_character_string_here

# Persistent Data Storage Directory
DATA_DIR=./data
